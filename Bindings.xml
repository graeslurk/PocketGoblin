<Bindings>
    <Binding name="POCKETGOBLIN_SELL" category="Pocket Goblin">
        PocketGoblin_ToggleSellHovered()
    </Binding>
    <Binding name="POCKETGOBLIN_KEEP" category="Pocket Goblin">
        PocketGoblin_ToggleKeepHovered()
